# ==============================================================================
# Civic Case Engine — Git Ignore Rules
# 100% Privacy- & Security-Guaranteed: Geen persoonsdata of sleutels naar GitHub
# ==============================================================================

# Omgevingsvariabelen & API-sleutels
.env
.env.*
*.env

# Persoonlijke dossierdata & profielen (Strikt Lokaal)
Dossier/profile.json
Dossier/00_Master_Chronologie.*
Dossier/PROCESBUNDEL_*
Dossier/termijnen.json
Dossier/*.csv
Dossier/*.xlsx
Dossier/*.pdf
Dossier/*.docx
Dossier/*.html
Dossier/*.md
!Dossier/README.md
WERKMODEL_CASUS_*
send_*.py

# Ketengrootboek persoonlijke saldi en levende zaak (Strikt Lokaal)
Ketengrootboek/journaal.json
Ketengrootboek/memoriaal.json
Ketengrootboek/boek2_journaal.json
Ketengrootboek/ketengrootboek.json
Ketengrootboek/saldo.json
Ketengrootboek/tafel_besluiten.json
Ketengrootboek/chain_of_custody.jsonl
Ketengrootboek/*.beancount

# Dynamische inkomende en uitgaande post (alleen templates en .gitkeep blijven getrackt)
Incoming_Letters/*
!Incoming_Letters/.gitkeep
Outgoing_Drafts/*
!Outgoing_Drafts/.gitkeep
Outgoing_Letters/*
!Outgoing_Letters/.gitkeep

# Zaak van de persoon. Niet het programma.
werk/

# Bankmutaties & financiële logs
*.csv
*.tsv
*.zip
*_bank_audit_report.*

# Python runtime & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Logs & OS artifacts
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
